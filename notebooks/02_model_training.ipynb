 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🤖 Trading Forecasting - Treinamento de Modelos\n",
    "\n",
    "Este notebook implementa o treinamento de modelos Random Forest para previsão de descontos aplicáveis por material.\n",
    "\n",
    "## Objetivos:\n",
    "- Carregar dados preparados\n",
    "- Preprocessar dados para ML\n",
    "- Treinar modelos específicos por material\n",
    "- Avaliar performance dos modelos\n",
    "- Salvar modelos treinados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Importações necessárias\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import os\n",
    "import json\n",
    "import joblib\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from datetime import datetime\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Scikit-learn imports\n",
    "from sklearn.model_selection import train_test_split, cross_val_score, GridSearchCV\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "\n",
    "# Configurações\n",
    "plt.style.use('seaborn-v0_8')\n",
    "np.random.seed(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Carregamento dos Dados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Carregar dados preparados\n",
    "try:\n",
    "    df = pd.read_csv(\"../data/dados_preparados.csv\")\n",
    "    print(f\"✅ Dados carregados: {df.shape}\")\nexcept FileNotFoundError:\n",
    "    print(\"❌ Execute primeiro o notebook 01_data_exploration.ipynb\")\n",
    "    # Criar dados de exemplo\n",
    "    np.random.seed(42)\n",
    "    df = pd.DataFrame({\n",
    "        'CodigoMaterial': np.random.choice(['10000', '10001', '10002', '10003'], 1000),\n",
    "        'Fornecedor': np.random.choice(['Alpha Ltda', 'Beta Corp', 'Gamma SA', 'Delta Inc'], 1000),\n",
    "        'Quantidade': np.random.randint(50, 500, 1000),\n",
    "        'PrazoEntrega(dias)': np.random.randint(5, 30, 1000),\n",
    "        'CondicoesPagamento': np.random.choice(['À vista', '30 dias', '60 dias'], 1000),\n",
    "        'FreteIncluso': np.random.choice(['Sim', 'Não'], 1000),\n",
    "        'ValidadeProposta(dias)': np.random.randint(15, 60, 1000),\n",
    "        'PrecoUnitario(R$)': np.random.uniform(100, 500, 1000),\n",
    "        'DescontoAplicavel(%)': np.random.uniform(0, 25, 1000)\n",
    "    })\n",
    "    print(f\"📋 Usando dados de exemplo: {df.shape}\")\n",
    "\n",
    "print(f\"\\nMateriais únicos: {df['CodigoMaterial'].unique()}\")\n",
    "print(f\"Distribuição por material:\")\n",
    "print(df['CodigoMaterial'].value_counts())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Configuração do Pipeline de ML"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_ml_pipeline():\n",
    "    \"\"\"Cria pipeline de preprocessamento e modelo\"\"\"\n",
    "    \n",
    "    # Definir features categóricas e numéricas\n",
    "    categorical_features = ['Fornecedor', 'CondicoesPagamento', 'FreteIncluso']\n",
    "    numeric_features = ['Quantidade', 'PrazoEntrega(dias)', 'ValidadeProposta(dias)', 'PrecoUnitario(R$)']\n",
    "    \n",
    "    # Preprocessador\n",
    "    preprocessor = ColumnTransformer(\n",
    "        transformers=[\n",
    "            ('cat', OneHotEncoder(handle_unknown='ignore', drop='first'), categorical_features),\n",
    "            ('num', StandardScaler(), numeric_features)\n",
    "        ],\n",
    "        remainder='passthrough'\n",
    "    )\n",
    "    \n",
    "    # Pipeline completo\n",
    "    pipeline = Pipeline([\n",
    "        ('preprocessor', preprocessor),\n",
    "        ('regressor', RandomForestRegressor(\n",
    "            n_estimators=100,\n",
    "            max_depth=10,\n",
    "            min_samples_split=5,\n",
    "            min_samples_leaf=2,\n",
    "            random_state=42,\n",
    "            n_jobs=-1\n",
    "        ))\n",
    "    ])\n",
    "    \n",
    "    return pipeline, categorical_features, numeric_features\n",
    "\n",
    "# Testar pipeline\n",
    "pipeline, cat_features, num_features = create_ml_pipeline()\n",
    "print(f\"✅ Pipeline criado\")\n",
    "print(f\"Features categóricas: {cat_features}\")\n",
    "print(f\"Features numéricas: {num_features}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Função de Treinamento por Material"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def train_material_model(df_material, codigo_material, min_samples=20):\n",
    "    \"\"\"Treina modelo para um material específico\"\"\"\n",
    "    \n",
    "    print(f\"\\n📊 Treinando modelo para material {codigo_material}...\")\n",
    "    \n",
    "    # Verificar se há dados suficientes\n",
    "    if len(df_material) < min_samples:\n",
    "        print(f\"❌ Poucos dados ({len(df_material)} < {min_samples}), pulando...\")\n",
    "        return None, None\n",
    "    \n",
    "    # Preparar features e target\n",
    "    feature_columns = ['Fornecedor', 'Quantidade', 'PrazoEntrega(dias)',\n",
    "                      'CondicoesPagamento', 'FreteIncluso', 'ValidadeProposta(dias)', \n",
    "                      'PrecoUnitario(R$)']\n",
    "    \n",
    "    X = df_material[feature_columns]\n",
    "    y = df_material['DescontoAplicavel(%)']\n",
    "    \n",
    "    # Split treino/teste\n",
    "    test_size = min(0.3, max(0.1, 10/len(df_material)))  # Adaptativo baseado no tamanho\n",
    "    X_train, X_test, y_train, y_test = train_test_split(\n",
    "        X, y, test_size=test_size, random_state=42\n",
    "    )\n",
    "    \n",
    "    print(f\"   📈 Treino: {len(X_train)}, Teste: {len(X_test)}\")\n",
    "    \n",
    "    # Criar e treinar pipeline\n",
    "    pipeline, _, _ = create_ml_pipeline()\n",
    "    pipeline.fit(X_train, y_train)\n",
    "    \n",
    "    # Predições\n",
    "    y_pred_train = pipeline.predict(X_train)\n",
    "    y_pred_test = pipeline.predict(X_test)\n",
    "    \n",
    "    # Métricas\n",
    "    metrics = {\n",
    "        'codigo_material': codigo_material,\n",
    "        'samples_total': len(df_material),\n",
    "        'samples_train': len(X_train),\n",
    "        'samples_test': len(X_test),\n",
    "        'mae_train': mean_absolute_error(y_train, y_pred_train),\n",
    "        'mae_test': mean_absolute_error(y_test, y_pred_test),\n",
    "        'rmse_train': np.sqrt(mean_squared_error(y_train, y_pred_train)),\n",
    "        'rmse_test': np.sqrt(mean_squared_error(y_test, y_pred_test)),\n",
    "        'r2_train': r2_score(y_train, y_pred_train),\n",
    "        'r2_test': r2_score(y_test, y_pred_test),\n",
    "        'desconto_medio': float(y.mean()),\n",
    "        'desconto_std': float(y.std())\n",
    "    }\n",
    "    \n",
    "    print(f\"   ✅ MAE Teste: {metrics['mae_test']:.2f}%\")\n",
    "    print(f\"   ✅ R² Teste: {metrics['r2_test']:.3f}\")\n",
    "    \n",
    "    return pipeline, metrics\n",
    "\n",
    "print(\"✅ Função de treinamento definida\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Treinamento dos Modelos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Criar diretórios para salvar modelos\n",
    "os.makedirs(\"../models\", exist_ok=True)\n",
    "os.makedirs(\"../models/metrics\", exist_ok=True)\n",
    "\n",
    "# Dicionários para armazenar resultados\n",
    "trained_models = {}\n",
    "all_metrics = {}\n",
    "\n",
    "# Obter materiais únicos\n",
    "codigos_materiais = df['CodigoMaterial'].unique()\n",
    "print(f\"🎯 Treinando modelos para {len(codigos_materiais)} materiais...\")\n",
    "\n",
    "# Loop de treinamento\n",
    "for codigo in codigos_materiais:\n",
    "    # Filtrar dados do material\n",
    "    df_material = df[df['CodigoMaterial'] == codigo]\n",
    "    \n",
    "    # Treinar modelo\n",
    "    model, metrics = train_material_model(df_material, codigo)\n",
    "    \n",
    "    if model is not None:\n",
    "        # Salvar modelo\n",
    "        model_filename = f\"../models/modelo_material_{codigo}.joblib\"\n",
    "        joblib.dump(model, model_filename)\n",
    "        \n",
    "        # Armazenar resultados\n",
    "        trained_models[codigo] = model\n",
    "        all_metrics[codigo] = metrics\n",
    "        \n",
    "        print(f\"   💾 Modelo salvo: {model_filename}\")\n",
    "\n",
    "print(f\"\\n✅ Treinamento concluído! {len(trained_models)} modelos criados.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Análise dos Resultados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Criar DataFrame com métricas\n",
    "if all_metrics:\n",
    "    metrics_df = pd.DataFrame(all_metrics).T\n",
    "    print(\"=== RESUMO DOS MODELOS TREINADOS ===\\n\")\n",
    "    print(metrics_df[['samples_total', 'mae_test', 'r2_test', 'desconto_medio']].round(3))\n",
    "    \n",
    "    # Salvar métricas detalhadas\n",
    "    with open('../models/metrics/training_metrics.json', 'w') as f:\n",
    "        json.dump(all_metrics, f, indent=2)\n",
    "    \n",
    "    print(f\"\\n💾 Métricas salvas em: ../models/metrics/training_metrics.json\")\nelse:\n",
    "    print(\"❌ Nenhum modelo foi treinado com sucesso\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualização das métricas\n",
    "if all_metrics:\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
    "    \n",
    "    # MAE por material\n",
    "    mae_values = [metrics['mae_test'] for metrics in all_metrics.values()]\n",
    "    material_codes = list(all_metrics.keys())\n",
    "    \n",
    "    axes[0,0].bar(material_codes, mae_values)\n",
    "    axes[0,0].set_title('MAE por Material')\n",
    "    axes[0,0].set_ylabel('MAE (%)')\n",
    "    axes[0,0].tick_params(axis='x', rotation=45)\n",
    "    \n",
    "    # R² por material\n",
    "    r2_values = [metrics['r2_test'] for metrics in all_metrics.values()]\n",
    "    axes[0,1].bar(material_codes, r2_values)\n",
    "    axes[0,1].set_title('R² por Material')\n",
    "    axes[0,1].set_ylabel('R²')\n",
    "    axes[0,1].tick_params(axis='x', rotation=45)\n",
    "    \n",
    "    # Distribuição de MAE\n",
    "    axes[1,0].hist(mae_values, bins=10, alpha=0.7)\n",
    "    axes[1,0].set_title('Distribuição de MAE')\n",
    "    axes[1,0].set_xlabel('MAE (%)')\n",
    "    \n",
    "    # Relação amostras vs performance\n",
    "    sample_counts = [metrics['samples_total'] for metrics in all_metrics.values()]\n",
    "    axes[1,1].scatter(sample_counts, mae_values)\n",
    "    axes[1,1].set_title('Amostras vs MAE')\n",
    "    axes[1,1].set_xlabel('Número de Amostras')\n",
    "    axes[1,1].set_ylabel('MAE (%)')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # Estatísticas gerais\n",
    "    print(f\"\\n=== ESTATÍSTICAS GERAIS ===\\n\")\n",
    "    print(f\"MAE médio: {np.mean(mae_values):.2f}%\")\n",
    "    print(f\"MAE mínimo: {np.min(mae_values):.2f}%\")\n",
    "    print(f\"MAE máximo: {np.max(mae_values):.2f}%\")\n",
    "    print(f\"R² médio: {np.mean(r2_values):.3f}\")\n",
    "    print(f\"Total de amostras: {sum(sample_counts):,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Análise de Importância das Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analisar importância das features para um modelo de exemplo\n",
    "if trained_models:\n",
    "    # Pegar primeiro modelo disponível\n",
    "    sample_material = list(trained_models.keys())[0]\n",
    "    sample_model = trained_models[sample_material]\n",
    "    \n",
    "    print(f\"📊 Análise de importância para material {sample_material}:\")\n",
    "    \n",
    "    # Obter importâncias do Random Forest\n",
    "    rf_regressor = sample_model.named_steps['regressor']\n",
    "    feature_importances = rf_regressor.feature_importances_\n",
    "    \n",
    "    # Obter nomes das features após preprocessamento\n",
    "    preprocessor = sample_model.named_steps['preprocessor']\n",
    "    \n",
    "    # Features categóricas (após OneHot)\n",
    "    cat_feature_names = []\n",
    "    if hasattr(preprocessor.named_transformers_['cat'], 'get_feature_names_out'):\n",
    "        cat_feature_names = list(preprocessor.named_transformers_['cat'].get_feature_names_out())\n",
    "    \n",
    "    # Features numéricas\n",
    "    num_feature_names = ['Quantidade', 'PrazoEntrega(dias)', 'ValidadeProposta(dias)', 'PrecoUnitario(R$)']\n",
    "    \n",
    "    all_feature_names = cat_feature_names + num_feature_names\n",
    "    \n",
    "    # Criar DataFrame de importâncias\n",
    "    if len(all_feature_names) == len(feature_importances):\n",
    "        importance_df = pd.DataFrame({\n",
    "            'feature': all_feature_names,\n",
    "            'importance': feature_importances\n",
    "        }).sort_values('importance', ascending=False)\n",
    "        \n",
    "        print(\"\\nTop 10 features mais importantes:\")\n",
    "        print(importance_df.head(10))\n",
    "        \n",
    "        # Visualização\n",
    "        plt.figure(figsize=(12, 8))\n",
    "        top_features = importance_df.head(15)\n",
    "        plt.barh(range(len(top_features)), top_features['importance'])\n",
    "        plt.yticks(range(len(top_features)), top_features['feature'])\n",
    "        plt.xlabel('Importância')\n",
    "        plt.title(f'Importância das Features - Material {sample_material}')\n",
    "        plt.gca().invert_yaxis()\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "    else:\n",
    "        print(f\"⚠️ Inconsistência no número de features: {len(all_feature_names)} vs {len(feature_importances)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Validação Cruzada (Opcional)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Validação cruzada para um material com dados suficientes\n",
    "if trained_models:\n",
    "    # Encontrar material com mais dados\n",
    "    material_counts = df['CodigoMaterial'].value_counts()\n",
    "    best_material = material_counts.index[0]\n",
    "    \n",
    "    if material_counts[best_material] >= 50:  # Só se tiver dados suficientes\n",
    "        print(f\"🔄 Validação cruzada para material {best_material} ({material_counts[best_material]} amostras)...\")\n",
    "        \n",
    "        # Preparar dados\n",
    "        df_material = df[df['CodigoMaterial'] == best_material]\n",
    "        feature_columns = ['Fornecedor', 'Quantidade', 'PrazoEntrega(dias)',\n",
    "                          'CondicoesPagamento', 'FreteIncluso', 'ValidadeProposta(dias)', \n",
    "                          'PrecoUnitario(R$)']\n",
    "        \n",
    "        X = df_material[feature_columns]\n",
    "        y = df_material['DescontoAplicavel(%)']\n",
    "        \n",
    "        # Criar pipeline\n",
    "        pipeline, _, _ = create_ml_pipeline()\n",
    "        \n",
    "        # Validação cruzada\n",
    "        cv_scores = cross_val_score(pipeline, X, y, cv=5, scoring='neg_mean_absolute_error')\n",
    "        cv_scores = -cv_scores  # Converter para positivo\n",
    "        \n",
    "        print(f\"\\n📈 Resultados da Validação Cruzada (5-fold):\")\n",
    "        print(f\"   MAE médio: {cv_scores.mean():.2f}% (±{cv_scores.std()*2:.2f}%)\")\n",
    "        print(f\"   MAE por fold: {[f'{score:.2f}%' for score in cv_scores]}\")\n",
    "    else:\n",
    "        print(\"⚠️ Dados insuficientes para validação cruzada robusta\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Resumo e Próximos Passos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Resumo final\n",
    "print(\"=== RESUMO DO TREINAMENTO ===\\n\")\n",
    "print(f\"✅ Modelos treinados: {len(trained_models)}\")\n",
    "print(f\"✅ Arquivos salvos em: ../models/\")\n",
    "print(f\"✅ Métricas salvas em: ../models/metrics/training_metrics.json\")\n",
    "\n",
    "if all_metrics:\n",
    "    mae_values = [metrics['mae_test'] for metrics in all_metrics.values()]\n",
    "    print(f\"\\n📊 Performance Geral:\")\n",
    "    print(f\"   MAE médio: {np.mean(mae_values):.2f}%\")\n",
    "    print(f\"   Melhor MAE: {np.min(mae_values):.2f}%\")\n",
    "    print(f\"   Pior MAE: {np.max(mae_values):.2f}%\")\n",
    "\n",
    "print(f\"\\n🎯 Próximos passos:\")\n",
    "print(f\"   1️⃣ Execute o notebook 03_model_inference.ipynb para fazer previsões\")\n",
    "print(f\"   2️⃣ Execute o notebook 04_sagemaker_deployment.ipynb para deploy na AWS\")\n",
    "print(f\"   3️⃣ Considere otimização de hiperparâmetros se necessário\")\n",
    "\n",
    "# Salvar informações de sessão\n",
    "session_info = {\n",
    "    'timestamp': datetime.now().isoformat(),\n",
    "    'models_trained': len(trained_models),\n",
    "    'materials': list(trained_models.keys()),\n",
    "    'avg_mae': np.mean(mae_values) if all_metrics else None,\n",
    "    'total_samples': df.shape[0]\n",
    "}\n",
    "\n",
    "with open('../models/training_session.json', 'w') as f:\n",
    "    json.dump(session_info, f, indent=2)\n",
    "\n",
    "print(f\"\\n💾 Informações da sessão salvas em: ../models/training_session.json\")"
   ]
  }
